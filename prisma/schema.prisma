// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// CREATOR — the Spotlite product's customer
// (auth itself is handled by Supabase Auth; this table
// just mirrors the creator's id + a few product-specific fields)
// ─────────────────────────────────────────────
enum SubscriptionTier {
  FREE
  STARTER
  GROWTH
  UNLIMITED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model Creator {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Nigerian phone number, e.g. +2348012345678 — validated at signup
  // (must match +234 followed by 10 digits). Nullable since accounts
  // created before this field existed won't have one.
  phone        String?
  // Optional — set at signup or later from the profile page. Shown on
  // the creator's own profile and in the admin creators table.
  companyName  String?
  createdAt    DateTime @default(now())
  // Updated every time this creator successfully logs in — the basis
  // for tracking how actively each account uses the platform. Null
  // means they've never logged in since this field was added (or ever,
  // for an admin-created account nobody's used yet).
  lastLoginAt  DateTime?

  // Profile
  avatarUrl      String?
  // True for anyone who completed the OTP signup flow (the only way a
  // real Creator row gets created in that path) or an admin-created
  // account — false is reserved for a future path where that isn't
  // guaranteed.
  emailVerified  Boolean @default(true)
  // Soft-pause, distinct from deletion — a deactivated account can't log
  // in, but nothing about them is removed, and it's reversible.
  isDeactivated  Boolean @default(false)
  // Storage for the preference only — the actual "email me when a
  // client views this" trigger isn't wired up yet (see notes where
  // views are tracked); needs rate-limiting first so it can't spam
  // someone on every single page load of a popular delivery.
  notifyOnView   Boolean @default(false)

  // Which paid tier they're on, and whether that tier is currently in
  // good standing. If subscriptionActive is false (lapsed, cancelled,
  // failed renewal), the creator is treated as FREE for cap purposes
  // regardless of what subscriptionTier still says — that field is kept
  // as a historical/display record, not the source of truth for access.
  subscriptionTier         SubscriptionTier @default(FREE)
  subscriptionActive       Boolean          @default(false)
  // Monthly vs. annual billing — null for anyone on FREE, or predating
  // this field (treated as monthly, since that was the only option
  // before annual billing existed).
  subscriptionCycle        BillingCycle?
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackEmailToken       String?
  subscriptionRenewsAt     DateTime?

  // The start of the current billing cycle for a paid tier — updated to
  // "now" every time a subscription is created or renews, so project
  // counts can be measured against it. Free tier doesn't use this; it
  // uses a rolling 30-day window computed at read time instead, since
  // there's no billing event to anchor a free cycle to.
  currentCycleStart DateTime @default(now())

  // Admin controls. isComped grants full Unlimited-tier access without
  // any real Paystack subscription — checked ahead of subscriptionActive
  // everywhere access is gated. discountPercent (0-100) is applied the
  // next time this creator starts or switches a subscription — it
  // doesn't retroactively change an already-active one.
  isComped        Boolean @default(false)
  discountPercent Int     @default(0)
  // Overrides the standard Free-tier limit (normally 1/month) for this
  // specific creator, without granting them a paid tier or full comped
  // access — they stay on Free, just with a raised allowance. Null
  // means "use the standard limit."
  freeTierLimitOverride Int?

  projects            Project[]
  paymentRecords      PaymentRecord[]
  passwordResetTokens PasswordResetToken[]
  portfolio           Portfolio?

  // ── Collaboration ──
  // Projects (owned by someone else) this creator has been added to
  // as a collaborator — distinct from `projects` above, which is
  // projects they themselves own.
  projectCollaborations ProjectCollaborator[] @relation("CollaboratorMemberships")
  // Invites this creator has sent out, across any of their projects.
  invitesSent           ProjectInvite[]       @relation("InvitesSent")
  // Every file this specific creator has personally uploaded — across
  // their own projects and any they collaborate on. This is the field
  // that lets client feedback get routed to the right individual
  // rather than always going to whoever owns the project.
  uploadedMedia         Media[]               @relation("UploadedMedia")

  // ── Lifecycle email sequence ──
  // The anchor point every "day N" step is measured from — set to
  // createdAt for a brand-new signup, but NOT the same as createdAt
  // for accounts that existed before this system did: those get this
  // set to "now" via a one-time backfill, so they experience the same
  // staggered welcome → day 1 → day 2 sequence as a new signup,
  // rather than every step firing at once because their real signup
  // date is months in the past. Null only in the brief window before
  // that backfill/signup-time set actually runs.
  lifecycleSequenceStartedAt   DateTime?
  welcomeEmailSentAt           DateTime?
  portfolioInviteEmailSentAt   DateTime?
  projectManagementEmailSentAt DateTime?
  creativoPromoEmailSentAt     DateTime?
  // Updated every time the recurring "deliver a project" reminder
  // goes out — unlike the one-time steps above, this one repeats
  // forever, so it needs a "last sent" timestamp rather than a
  // single boolean-ish flag.
  lastDeliveryReminderSentAt   DateTime?

  // ── Project management (separate system from delivery) ──
  // Managed projects this creator owns — briefs, tasks, and their own
  // collaborator system, entirely independent of the delivery
  // Project model above.
  managedProjects              ManagedProject[]
  // Managed projects (owned by someone else) this creator has been
  // added to as a collaborator.
  managedProjectCollaborations ManagedProjectCollaborator[] @relation("ManagedProjectMemberships")
  managedProjectInvitesSent    ManagedProjectInvite[]       @relation("ManagedProjectInvitesSent")
  // Every task assigned to this specific creator, across any managed
  // project they're on — what lets "my tasks" be queried directly
  // without joining through every project they collaborate on.
  assignedTasks                Task[]                        @relation("AssignedTasks")
  // Tasks this creator created/assigned to someone else — the
  // opposite direction from assignedTasks above.
  createdTasks                 Task[]                        @relation("CreatedTasks")
  uploadedBriefAttachments     BriefAttachment[]              @relation("UploadedBriefAttachments")
  uploadedTaskAssets           TaskAsset[]                    @relation("UploadedTaskAssets")
}

// ─────────────────────────────────────────────
// PROJECT — one client delivery (e.g. "Soundhous 2026")
// ─────────────────────────────────────────────
// ─────────────────────────────────────────────
// DELIVERY STATUS — the real, creator-controlled workflow state of a
// project. Separate from per-file approve/revision (which is about
// individual files); this is about the project as a whole. Downloads
// are only ever unlocked once this reaches PAID — enforced server-side,
// not just hidden in the UI.
// ─────────────────────────────────────────────
enum DeliveryStatus {
  DELIVERED
  APPROVED
  PAID
}

model Project {
  id         String @id @default(uuid())
  slug       String @unique // used in the URL: yourproduct.com/{slug}
  clientName String
  deliveryStatus DeliveryStatus @default(DELIVERED)

  // access control
  passwordHash String
  // Plain-text copy of the same code, saved purely so the creator can
  // see and re-share it later. This one code only gates a client's
  // view of their own delivery — not an account or anything sensitive —
  // so keeping a readable copy is a reasonable tradeoff here. Older
  // projects created before this field existed will have this as null.
  accessCode   String?

  // Option A payment: one-time ₦5,000 per project
  paid        Boolean   @default(false)
  paidAt      DateTime?
  paystackRef String?   @unique // Paystack transaction reference

  // whether the free-tier Spotlite badge shows on this project
  // automatically false once `paid` is true
  badgeVisible Boolean @default(true)

  // whether viewers must submit an email before the password screen
  // defaults on for free tier, creator can toggle off once paid
  captureViewerEmail Boolean @default(true)

  // branding (all optional — falls back to default Spotlite styling)
  logoUrl      String?
  primaryColor String? // e.g. "#C9A84C"
  bgColor      String? // e.g. "#080808"

  // The hero banner: creator picks which uploaded file leads the page,
  // and writes a line of copy tailored to that specific client. Plain
  // string id (not a formal relation) — resolved against project.media
  // in application code, so a deleted file just falls back gracefully.
  heroMediaId String?
  heroTagline String?

  // Real page-view counter — increments on every load of the public
  // delivery page, regardless of whether email capture is even turned
  // on. Separate from ViewerEmail, which only records people who
  // actually submitted their email.
  viewCount Int @default(0)

  // Counts every file replacement (revision uploads) across this
  // project's lifetime. Capped in application code — without this, a
  // single ₦5,000 payment could otherwise be stretched into an
  // unlimited free pipeline by repeatedly swapping in unrelated content.
  replaceCount Int @default(0)

  // Counts how many times a creator has used "Add more files" after the
  // project was first created. Capped in application code — without this,
  // one payment could keep growing forever into an unrelated ongoing
  // delivery, same reasoning as the replace-file cap.
  additionalUploadCount Int @default(0)

  // Soft delete — a "deleted" project is hidden from every normal view
  // (dashboard list, direct links, the public delivery page all treat
  // it as gone) but the row itself stays. This matters specifically for
  // billing: usage counts are based on how many projects were *created*
  // in a cycle, not how many currently still exist — otherwise creating
  // and deleting on a loop would let someone bypass their tier limit
  // for free, since a hard-deleted row simply vanishes from any count.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  media        Media[]
  viewerEmails ViewerEmail[]
  sections     MediaSection[]

  // The managed project (brief + tasks) linked to this delivery, if
  // any — lets the public delivery page also show task/progress
  // alongside file review. Optional; most delivery projects won't
  // have one. The actual foreign key lives on ManagedProject
  // (deliveryProjectId), this is just its reverse for querying
  // project.managedProject directly.
  managedProject ManagedProject?

  // ── Collaboration ──
  // Everyone besides the owner who has access to this project. The
  // owner is never a row here — ownership is `creatorId` above.
  collaborators ProjectCollaborator[]
  // Every invite ever sent for this project, pending or otherwise —
  // kept even after acceptance/decline as a record of who was asked.
  invites       ProjectInvite[]
}

// ─────────────────────────────────────────────
// PROJECT COLLABORATOR — someone other than the project owner who has
// been invited onto a project and can upload/view files on it. Created
// the moment a ProjectInvite below gets accepted. Deliberately does
// NOT carry a role field yet — every collaborator has the same access
// today (upload, see other collaborators' files, but not client
// emails/analytics, which stay owner-only) — a role/permission tier
// can be layered on top of this table later without a breaking change.
// ─────────────────────────────────────────────
model ProjectCollaborator {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  creator   Creator  @relation("CollaboratorMemberships", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String
  addedAt   DateTime @default(now())

  // One person can only be added to a given project once.
  @@unique([projectId, creatorId])
  @@index([projectId])
  @@index([creatorId])
}

// ─────────────────────────────────────────────
// PROJECT INVITE — a pending invitation to collaborate on a project,
// sent to an email address. Works identically whether or not that
// email already has a Creator account: if they do, opening the invite
// link logs them straight in and adds them to the project; if they
// don't, it walks them through signup first, then adds them — the
// same two-path pattern used by Figma, Notion, and most collaborative
// products. tokenHash (never the raw token) is stored here, same
// principle as PasswordResetToken — the plain token only ever exists
// in the emailed link itself, so a leaked database can't be used to
// forge acceptance of someone else's invite.
// ─────────────────────────────────────────────
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model ProjectInvite {
  id                  String       @id @default(uuid())
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           String
  invitedByCreator    Creator      @relation("InvitesSent", fields: [invitedByCreatorId], references: [id], onDelete: Cascade)
  invitedByCreatorId  String
  // The invitee's email — always stored even when they're invited via
  // an existing-account search, since the invite itself is fundamentally
  // addressed to an email address, not an account id. Matched against
  // Creator.email at signup/login time to auto-link this invite.
  email               String
  tokenHash           String       @unique
  status               InviteStatus @default(PENDING)
  expiresAt            DateTime
  createdAt             DateTime     @default(now())
  respondedAt           DateTime?

  @@index([projectId])
  @@index([email])
}

// ─────────────────────────────────────────────
// MEDIA SECTION — a creator-named grouping of files within a project.
// This is what replaces the old hardcoded "Films" / "Photography"
// split: a wedding videographer might call theirs "Highlights" and
// "Ceremony Photos," while an interior designer might use "Room
// Renders" and "Floor Plans," or a branding studio "Logo Concepts" and
// "Brand Guidelines." A project can have as many sections as needed.
// ─────────────────────────────────────────────
model MediaSection {
  id           String    @id @default(uuid())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  name         String
  mediaType    MediaType
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  media   Media[]
  folders Folder[]

  @@index([projectId])
}

// ─────────────────────────────────────────────
// FOLDER — an optional sub-grouping within a section, one level deep.
// Client-facing, not just an internal organizing label: on the
// delivery page, each folder gets its own real sub-heading and
// gallery within the section it belongs to — e.g. a "Q3 Deliverables"
// section might contain a "Sonos Campaign" folder and a separate
// "Sonance Campaign" folder, each with its own distinct set of files.
// A file in a section doesn't have to belong to a folder — folders
// are optional structure, not a requirement.
// ─────────────────────────────────────────────
model Folder {
  id           String       @id @default(uuid())
  section      MediaSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId    String
  name         String
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())

  media Media[]

  @@index([sectionId])
}

// ─────────────────────────────────────────────
// MANAGED PROJECT — the project-management side of Showwork, entirely
// separate from Project (client delivery) above. This is where the
// actual work gets planned and tracked before anything is ever
// delivered: a brief, an overall status, its own collaborators, and
// per-person tasks. Optionally linked to a real delivery Project so
// clients can see live task progress on the same page they already
// use to review files — the two systems stay structurally
// independent (deliberately not reusing ProjectCollaborator/
// ProjectInvite, which are scoped to delivery projects specifically),
// but can share one client-facing view when a creator wants that.
// ─────────────────────────────────────────────
enum ManagedProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model ManagedProject {
  id        String  @id @default(uuid())
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String
  name      String
  // Manually set by the owner — distinct from the completion
  // percentage (computed at read time from task statuses, never
  // stored), since a project can genuinely be "in progress" with 0%
  // of tasks marked done yet, or wrapped up as "completed" even with
  // a couple of minor tasks never formally closed out.
  status ManagedProjectStatus @default(NOT_STARTED)

  // ── Creative brief — every field optional, filled in only where
  // it's actually relevant to a given project. Editable by the owner
  // (or an admin); collaborators can read but not edit.
  briefObjective         String?
  briefBackground        String?
  briefTargetAudience    String?
  briefCreativeDirection String?
  briefDeliverables      String?
  briefBrandGuidelines   String?
  briefReferences        String?
  briefRequiredFormats   String?
  briefPlatforms         String?
  briefImportantNotes    String?
  briefDeadline          DateTime?
  // A single on/off switch for the whole brief being visible on the
  // client portal — simpler and safer-by-default than deciding
  // field-by-field, and defaults to hidden until the owner
  // deliberately shares it.
  briefVisibleToClient   Boolean   @default(false)

  // Optional link to a real client delivery — when set, that
  // delivery's public page also shows this managed project's
  // task/progress rollup. Unique: a delivery project can only ever be
  // linked from one managed project, so there's never ambiguity about
  // which task list a client should see.
  deliveryProject   Project? @relation(fields: [deliveryProjectId], references: [id], onDelete: SetNull)
  deliveryProjectId String?  @unique

  // Null until the owner actually publishes — the single flag that
  // decides what the client portal shows: task/progress status
  // beforehand, or the actual finished files afterward. Set the
  // moment publish happens; approved task uploads get promoted into
  // real Media rows on the linked delivery project at that same time
  // (see TaskAsset.promotedToMediaId).
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators ManagedProjectCollaborator[]
  invites       ManagedProjectInvite[]
  tasks         Task[]
  milestones    Milestone[]
  briefAttachments BriefAttachment[]
}

// ─────────────────────────────────────────────
// BRIEF ATTACHMENT — a reference file or piece of inspiration attached
// to a managed project's brief. Uses the same R2 storage architecture
// as delivery Media (fileKey), just a separate table since these
// aren't deliverable client-facing files — they're internal reference
// material for whoever's doing the work.
// ─────────────────────────────────────────────
model BriefAttachment {
  id                  String         @id @default(uuid())
  managedProject      ManagedProject @relation(fields: [managedProjectId], references: [id], onDelete: Cascade)
  managedProjectId    String
  fileKey             String
  filename            String?
  uploadedBy          Creator        @relation("UploadedBriefAttachments", fields: [uploadedByCreatorId], references: [id], onDelete: Cascade)
  uploadedByCreatorId String
  createdAt           DateTime       @default(now())

  @@index([managedProjectId])
}

// ─────────────────────────────────────────────
// MILESTONE — an optional grouping/phase for tasks within a managed
// project (e.g. "Pre-production", "Shoot week", "Post & delivery").
// A task doesn't have to belong to one.
// ─────────────────────────────────────────────
model Milestone {
  id               String         @id @default(uuid())
  managedProject   ManagedProject @relation(fields: [managedProjectId], references: [id], onDelete: Cascade)
  managedProjectId String
  name             String
  dueDate          DateTime?
  displayOrder     Int            @default(0)
  createdAt        DateTime       @default(now())

  tasks Task[]

  @@index([managedProjectId])
}

// ─────────────────────────────────────────────
// MANAGED PROJECT COLLABORATOR — who has access to a managed project,
// separate from ProjectCollaborator (which is scoped to delivery
// projects). Kept as its own table rather than reusing that one,
// since the two systems are deliberately independent.
// ─────────────────────────────────────────────
model ManagedProjectCollaborator {
  id               String         @id @default(uuid())
  managedProject   ManagedProject @relation(fields: [managedProjectId], references: [id], onDelete: Cascade)
  managedProjectId String
  creator          Creator        @relation("ManagedProjectMemberships", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId        String
  addedAt          DateTime       @default(now())

  @@unique([managedProjectId, creatorId])
  @@index([managedProjectId])
  @@index([creatorId])
}

// ─────────────────────────────────────────────
// MANAGED PROJECT INVITE — the same pattern as ProjectInvite (the
// delivery-side collaboration invite), scoped to managed projects
// instead. Lets an owner invite someone by email even when that
// person has no Showwork account yet: accepting the link either logs
// an existing account straight in and adds them, or walks a brand-new
// person through signup first, then adds them — reusing InviteStatus,
// the same enum ProjectInvite already uses, since the lifecycle is
// identical.
// ─────────────────────────────────────────────
model ManagedProjectInvite {
  id                 String         @id @default(uuid())
  managedProject     ManagedProject @relation(fields: [managedProjectId], references: [id], onDelete: Cascade)
  managedProjectId   String
  invitedByCreator   Creator        @relation("ManagedProjectInvitesSent", fields: [invitedByCreatorId], references: [id], onDelete: Cascade)
  invitedByCreatorId String
  email              String
  tokenHash          String         @unique
  status             InviteStatus   @default(PENDING)
  expiresAt          DateTime
  createdAt          DateTime       @default(now())
  respondedAt        DateTime?

  @@index([managedProjectId])
  @@index([email])
}

// ─────────────────────────────────────────────
// TASK — one piece of work assigned to exactly one person on a
// managed project. Only that person (or the project owner) is allowed
// to move its status — enforced in the task update route, not here;
// this model just holds the data.
// ─────────────────────────────────────────────
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InternalReviewStatus {
  PENDING
  APPROVED
  NEEDS_CHANGES
}

model Task {
  id                  String         @id @default(uuid())
  managedProject      ManagedProject @relation(fields: [managedProjectId], references: [id], onDelete: Cascade)
  managedProjectId    String
  title               String
  description         String?

  assignedTo          Creator        @relation("AssignedTasks", fields: [assignedToCreatorId], references: [id], onDelete: Cascade)
  assignedToCreatorId String
  // Whoever created/assigned this task — usually the project owner,
  // but kept distinct from assignedTo since they're frequently
  // different people. Lets a task list show "assigned by X" alongside
  // "assigned to Y".
  createdBy           Creator        @relation("CreatedTasks", fields: [createdByCreatorId], references: [id], onDelete: Cascade)
  createdByCreatorId  String

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate  DateTime?

  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Set automatically the moment status transitions to DONE, cleared
  // if it's ever moved back out of DONE — distinct from updatedAt,
  // which changes on any edit, not only completion.
  completedAt DateTime?

  linkedAssets TaskAsset[]
  folders      TaskFolder[]

  @@index([managedProjectId])
  @@index([assignedToCreatorId])
  @@index([milestoneId])
}

// ─────────────────────────────────────────────
// TASK FOLDER — an optional sub-grouping within a single task's own
// uploaded work, one level deep. Same idea as Folder on the delivery
// side, scoped to a task instead of a section — e.g. "Round 1
// drafts" and "Round 2 final" as two separate folders under the same
// task, each holding their own uploaded files.
// ─────────────────────────────────────────────
model TaskFolder {
  id           String   @id @default(uuid())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  assets TaskAsset[]

  @@index([taskId])
}

// ─────────────────────────────────────────────
// TASK ASSET — the actual file(s) uploaded to complete a task, plus
// the project owner's internal review of it. This is the gate that
// sits BEFORE anything ever reaches a client: the owner approves or
// requests changes here first — entirely separate from, and earlier
// than, the client's own approve/revision flow (MediaReview), which
// only ever applies after publish, once this has been promoted into
// a real Media row.
// ─────────────────────────────────────────────
model TaskAsset {
  id                  String    @id @default(uuid())
  task                Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId              String
  fileKey             String
  filename            String?
  // The file's actual type — carried through to the promoted Media
  // row at publish time, so a video uploaded to a task doesn't
  // silently become mislabeled as a photo once it reaches the client.
  type                MediaType @default(PHOTO)
  uploadedBy          Creator   @relation("UploadedTaskAssets", fields: [uploadedByCreatorId], references: [id], onDelete: Cascade)
  uploadedByCreatorId String

  // Which folder within this task, if any — optional extra layer of
  // organization, not a requirement. Most uploads sit directly on the
  // task with no folder.
  folder   TaskFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String?

  internalReviewStatus InternalReviewStatus @default(PENDING)
  internalReviewNote   String?
  internalReviewedAt   DateTime?

  // Set once this asset has been promoted into a real, client-facing
  // Media row at publish time — prevents the same asset from ever
  // being published twice. Null until that happens.
  promotedToMedia   Media?  @relation(fields: [promotedToMediaId], references: [id], onDelete: SetNull)
  promotedToMediaId String? @unique

  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─────────────────────────────────────────────
// MEDIA — one photo or video within a project
// ─────────────────────────────────────────────
enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT // .docx
  PDF
}

enum ApprovalStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
}

model Media {
  id           String    @id @default(uuid())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  type         MediaType
  fileKey      String // R2 object key, e.g. "projects/{projectId}/video/invisible.mp4"
  caption      String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  // Which creator-named section this file belongs to. Nullable so
  // existing media uploaded before sections existed doesn't break —
  // it just displays ungrouped. onDelete: Cascade — deleting a section
  // permanently deletes every file inside it, not just the grouping.
  section   MediaSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String?

  // Which folder within that section, if any — folders are an
  // optional extra layer of organization inside a section, not a
  // requirement. Nullable: most files sit directly in their section
  // with no folder. onDelete: Cascade — deleting a folder deletes the
  // files inside it too, same reasoning as deleting a section.
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String?

  // Which specific creator actually uploaded this file — the project
  // owner for a solo project, or possibly a collaborator on a shared
  // one. Nullable for files uploaded before this field existed.
  // onDelete: SetNull rather than Cascade — if an uploader's account
  // is ever removed, their past uploads should stay in the project,
  // just with the attribution cleared, not get deleted along with
  // them. This is the field client feedback notifications are routed
  // through: a review on this file emails whoever this points to,
  // plus the project owner, rather than only ever the owner.
  uploadedByCreator   Creator? @relation("UploadedMedia", fields: [uploadedByCreatorId], references: [id], onDelete: SetNull)
  uploadedByCreatorId String?

  // Aggregate/cached view of this file's overall status, recomputed
  // from every individual review in MediaReview below whenever one is
  // added — not the only record of a review anymore. Kept here so the
  // dashboard/grid can show a status without joining every review each
  // time. approvalNote/reviewerEmail reflect the most recent
  // NEEDS_REVISION note specifically (see the review route for the
  // aggregation rule).
  approvalStatus ApprovalStatus @default(PENDING)
  approvalNote   String?
  reviewedAt     DateTime?
  reviewerEmail  String?

  reviews MediaReview[]
  videoComments VideoComment[]

  // Set only for Media rows that originated from the project
  // management pipeline — this file was a task's uploaded work,
  // internally approved by the owner, then promoted here at publish
  // time. Most Media rows (regular deliveries) will have this null.
  promotedFromTaskAsset TaskAsset?
}

// ─────────────────────────────────────────────
// MEDIA REVIEW — one reviewer's actual review, permanently kept. Media
// can be reviewed by more than one person (a bride and her mother-in-law,
// for instance) — this table is what makes that possible, since a
// second reviewer's input should add to the record, not silently
// overwrite the first person's.
// ─────────────────────────────────────────────
model MediaReview {
  id            String         @id @default(uuid())
  media         Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId       String
  reviewerName  String?
  reviewerEmail String
  status        ApprovalStatus // only ever APPROVED or NEEDS_REVISION in practice
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // One person can only have a single, current verdict on a given
  // file — submitting again either updates it (if they changed their
  // mind) or is rejected as a duplicate (if it's identical to what they
  // already said). Never a second row for the same person.
  @@unique([mediaId, reviewerEmail])
  @@index([mediaId])
}

// ─────────────────────────────────────────────
// VIDEO COMMENT — a pinned note tied to one exact moment in a video's
// playback, entirely separate from the single approve/needs-revision
// verdict a MediaReview represents. Unlike a review, there's no limit
// here: the same person can leave as many timestamped comments as they
// want on one video, each independent of the others — "the logo's
// wrong at 0:15" and "the audio cuts out at 1:45" are two different
// comments, not one overwriting the other.
// ─────────────────────────────────────────────
model VideoComment {
  id                    String   @id @default(uuid())
  media                 Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId               String
  reviewerName          String?
  reviewerEmail         String
  note                  String
  videoTimestampSeconds Float
  createdAt             DateTime @default(now())

  @@index([mediaId])
}

// ─────────────────────────────────────────────
// VIEWER EMAIL — captured from the client's client
// (the lead-gen mechanism)
// ─────────────────────────────────────────────
model ViewerEmail {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String?
  email     String
  viewedAt  DateTime @default(now())

  @@index([projectId])
}

// ─────────────────────────────────────────────
// PENDING SIGNUP — a signup that hasn't verified its email yet.
// The real Creator row only gets created once the OTP is confirmed;
// until then, everything (including the already-hashed password)
// sits here so nothing is stored twice.
// ─────────────────────────────────────────────
model PendingSignup {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  phone        String?
  companyName  String?
  passwordHash String
  otpCode      String
  otpExpiresAt DateTime
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────
// PAYMENT RECORD — a permanent log of every real charge, populated by
// the webhook. This is the actual source of truth for revenue reporting;
// subscriptionActive/subscriptionTier only reflect *current* state and
// can't answer "how much did we make in March," so this table exists
// specifically to make that answerable.
// ─────────────────────────────────────────────
enum PaymentType {
  PROJECT_ONE_TIME
  SUBSCRIPTION_INITIAL
  SUBSCRIPTION_RENEWAL
}

model PaymentRecord {
  id                String            @id @default(uuid())
  creator           Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId         String
  amountNgn         Int
  type              PaymentType
  tier              SubscriptionTier?
  cycle             BillingCycle?
  paystackReference String?
  createdAt         DateTime          @default(now())

  @@index([creatorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// PLATFORM SETTINGS — a single-row config table. Currently just holds
// the platform-wide discount percentage an admin can set, applied to
// every new subscription started while it's active.
// ─────────────────────────────────────────────
model PlatformSettings {
  id                    String @id @default("singleton")
  globalDiscountPercent Int    @default(0)
  // A rough, admin-typed figure shown on the Creativo landing page
  // (e.g. "50+ members") — deliberately not a precise live count, so
  // it never needs a real membership-tracking query behind it.
  creativoMemberCountLabel String?
}

// ─────────────────────────────────────────────
// CREATIVO LEADERBOARD ENTRY — one winning member for one category in
// one period, entered by hand in the admin. periodDate anchors it to
// a real month (the 1st of whatever month it represents) so "this
// month" / "last month" can be computed from the actual date rather
// than a hand-typed label that could drift out of sync. A category +
// period can genuinely have zero entries (nobody selected yet) or
// just one — the public page has to render both of those honestly,
// never padding with placeholder rows.
// ─────────────────────────────────────────────
model CreativoLeaderboardEntry {
  id               String   @id @default(uuid())
  name             String
  profileImageUrl  String?
  category         String // "Photography" | "Videography" | "Motion" | "Editing"
  whatTheyDo       String? // short line — what they actually do
  contact          String? // email, phone, or handle — admin's choice of format
  // Shown as a real "View portfolio" link on the public page.
  portfolioUrl     String?
  // Digits only, no "+" or spaces (e.g. "2348012345678") — used to
  // build a wa.me deep link on the public page, pre-filled with a
  // message referencing the spotlight itself. Separate from `contact`
  // because it needs a predictable, parseable format to build that
  // link correctly, not free text.
  whatsappNumber   String?
  wonFor           String // e.g. "Best wedding series"
  points           Int      @default(0)
  periodDate       DateTime // the 1st of the month this entry represents
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category, periodDate])
}

// ─────────────────────────────────────────────
// CREATIVO WEBINAR — entered once in the admin with a real date/time;
// upcoming vs. past is never stored, always computed by comparing
// `startsAt` to the current time at render — so a webinar flips from
// upcoming to past on its own the moment it's happened, with no admin
// action required.
// ─────────────────────────────────────────────
model CreativoWebinar {
  id          String   @id @default(uuid())
  flyerImageUrl String?
  topic       String
  guests      String? // free text — one or more guest names
  startsAt    DateTime
  venue       String? // physical location, or "Online" / a platform name
  applyUrl    String?
  replayUrl   String? // filled in after the fact, for past webinars
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
}

// ─────────────────────────────────────────────
// PASSWORD RESET TOKEN — short-lived, single-use. The token stored here
// is a hash, never the plain value — same principle as passwords
// themselves. The plain token only ever exists in the email link itself.
// ─────────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(uuid())
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([creatorId])
}

// ─────────────────────────────────────────────
// PORTFOLIO — a creator's own always-on showcase. Distinct from
// Project (a one-off client delivery): no password, no viewer email
// gate, no approve/revision workflow, no payment gating — it's meant
// to be freely shareable (Instagram bio, business card) and
// continuously updated, never "delivered" once and left alone. Free
// for every creator regardless of subscription tier. One per creator.
// ─────────────────────────────────────────────
model Portfolio {
  id           String   @id @default(uuid())
  slug         String   @unique // useshowwork.com/p/{slug}
  companyName  String
  heroTagline  String?
  heroMediaId  String?
  logoUrl      String?
  primaryColor String?
  bgColor      String?
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Contact — how a client reaches out after seeing the work. All
  // optional: a creator can fill in as much or as little as they want,
  // and the public page only shows what's actually been filled in.
  contactEmail    String?
  whatsappNumber  String?
  ctaText         String?

  // Social — shown as icons in the footer, only for whichever ones the
  // creator actually filled in.
  instagramUrl String?
  twitterUrl   String?
  linkedinUrl  String?
  tiktokUrl    String?
  facebookUrl  String?
  youtubeUrl   String?

  // Intro / about section, shown before the portfolio's own sections
  // on the public page — a creator introducing themselves, like a
  // short resume. heroTagline above already covers the role/title
  // line; these cover the rest. All optional, same philosophy as
  // contact info: show only whatever's actually been filled in.
  bioText   String?
  bioPhotoUrl String?
  bioSkills String[] @default([])
  bioStat   String? // e.g. "50+ projects delivered"

  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String  @unique

  sections PortfolioSection[]
  media    PortfolioMedia[]
  testimonials PortfolioTestimonial[]
}

model PortfolioSection {
  id           String    @id @default(uuid())
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId  String
  name         String
  mediaType    MediaType
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  // Which of this section's own files stands in as its cover/banner —
  // creator-chosen. Falls back to the first uploaded file when null.
  coverMediaId String?

  media PortfolioMedia[]

  @@index([portfolioId])
}

model PortfolioMedia {
  id           String   @id @default(uuid())
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId  String
  section      PortfolioSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId    String?
  type         MediaType
  fileKey      String
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([portfolioId])
}

// A client testimonial the creator enters themselves — shown as a
// scrolling carousel on the public portfolio, right after the "Get in
// touch" section. Rating is optional since not every quote needs a
// star count attached.
model PortfolioTestimonial {
  id           String    @id @default(uuid())
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId  String
  clientName   String
  clientRole   String?
  quote        String
  rating       Int?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([portfolioId])
}
