{
  "name": "spotlite-presenter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && NODE_OPTIONS='--no-experimental-webstorage' next dev",
    "build": "node scripts/vps/prepare-netlify-handoff.mjs && node scripts/package-media-binaries.cjs && prisma generate && next build",
    "start": "NODE_OPTIONS='--no-experimental-webstorage' next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prestart": "npx prisma db push --accept-data-loss",
    "security:scan": "node scripts/security/secretlint-safe.cjs && python3 scripts/security/scan-repository.py --high-confidence",
    "security:audit-history": "python3 scripts/security/scan-repository.py --history",
    "worker:check": "node scripts/vps/worker.cjs --check",
    "test:vps-preparation": "node --test tests/vps-preparation.test.cjs",
    "worker:typecheck": "tsc --project tsconfig.worker.json",
    "worker:build": "npm run worker:typecheck && node scripts/vps/build-worker.mjs",
    "worker:check-built": "node dist-worker/main.cjs --check",
    "test:worker-build": "node --test tests/worker-build.test.mjs",
    "test:worker-lifecycle": "node --test tests/worker-lifecycle.test.mjs",
    "test:publishing-ownership": "node --test tests/publishing-ownership.test.cjs",
    "test:publishing-ownership-integration": "node --test tests/publishing-ownership.integration.test.cjs",
    "typecheck:publishing-ownership": "tsc --project tsconfig.publishing-ownership.json",
    "test:publishing-retry-policy": "node --test tests/publishing-retry-policy.test.cjs",
    "test:publishing-ownership-process": "node --test tests/publishing-ownership-process.integration.test.cjs",
    "worker:native:build": "node scripts/vps/build-native-worker.mjs",
    "worker:native:check": "node dist-worker-native/run.cjs --check",
    "worker:run": "node dist-worker-native/run.cjs --run",
    "worker:native:package": "node scripts/vps/package-native-disabled.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@netlify/functions": "^5.3.0",
    "@prisma/client": "^5.20.0",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@xdevplatform/chat-xdk": "0.5.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^11.11.0",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "juicebox-sdk": "0.3.7",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.2",
    "next": "15.3.6",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1",
    "sharp": "^0.34.5",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/word-extractor": "^1.0.6",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.25.12",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "secretlint": "13.0.7",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
