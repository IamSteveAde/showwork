# Postgres connection string (e.g. from Supabase's connection pooling URL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random long string used to sign session JWTs — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Your deployed app URL (no trailing slash)
NEXT_PUBLIC_APP_URL="https://yourproduct.com"

# Shared secret used by scheduled Netlify functions and per-post background workers
CRON_SECRET="replace-with-a-long-random-string"

# Optional social publishing channels (configure provider apps and callback URLs)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
META_GRAPH_API_VERSION="v26.0"
META_WEBHOOK_VERIFY_TOKEN=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_API_VERSION="202609"
# Enable only after LinkedIn grants r_member_postAnalytics to your app.
# An individual account can also authorize analytics from Channels.
LINKEDIN_ANALYTICS_ENABLED="false"
# Requires Page Messaging partner approval AND an implemented approved adapter.
LINKEDIN_MESSAGING_ENABLED="false"
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Cloudflare R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"

# TikTok Business Messaging: separate approved TikTok for Business app.
# Copy its TikTok account holder authorization URL from App Detail.
# Register /api/calendars/channels/tiktok-messaging/callback as redirect URL.
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
TIKTOK_BUSINESS_AUTH_URL=

# WhatsApp Cloud API: app credentials belong to the app used for channel tokens.
# Register /api/webhooks/whatsapp/messaging and subscribe to the messages field.
# Business Account ID, Phone Number ID and system-user token are entered in Channels.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Content Workspace Unlimited: NGN 59,900/month or NGN 682,860/year
PAYSTACK_CONTENT_WORKSPACE_UNLIMITED_MONTHLY_PLAN_CODE=PLN_3cxlhj43vferus5
PAYSTACK_CONTENT_WORKSPACE_UNLIMITED_ANNUAL_PLAN_CODE=PLN_5ub5x4bvtspdlg0
PAYSTACK_PLAN_CODE_STARTER_MONTHLY=PLN_2oxepdt4ptbhbtn
PAYSTACK_PLAN_CODE_STARTER_ANNUAL=PLN_zitp0xncpw838vo
PAYSTACK_PLAN_CODE_GROWTH_MONTHLY=PLN_8ckr4jjb60z66yo
PAYSTACK_PLAN_CODE_GROWTH_ANNUAL=PLN_6zpwnm9vt4ahbvz
PAYSTACK_PLAN_CODE_UNLIMITED_MONTHLY=PLN_cj6t3j4xwkd6e2n
PAYSTACK_PLAN_CODE_UNLIMITED_ANNUAL=PLN_39gqxnq6u5ou9w8
PAYSTACK_CONTENT_WORKSPACE_CREATOR_MONTHLY_PLAN_CODE=PLN_qb038m4vn9sxexj
PAYSTACK_CONTENT_WORKSPACE_CREATOR_ANNUAL_PLAN_CODE=PLN_wygn1xg4ty0br5g
